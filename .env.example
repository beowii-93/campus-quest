# Copy this file to .env and update the values.
APP_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
APP_TIMEZONE=Asia/Kolkata

# Use a long random value for any public deployment.
SECRET_KEY=replace-this-with-a-long-random-secret

# Local showcase only. Demo login is automatically disabled in production.
ENABLE_DEMO_LOGIN=1
COOKIE_SECURE=0

# Optional database path (relative paths are relative to the folder you launch from).
# DATABASE_PATH=instance/campusquest.db
